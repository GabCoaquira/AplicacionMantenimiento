<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvTituloSheetEst"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nuevo Estudiante"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#0D3B66"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Código (3 dígitos ingresados manualmente)"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etCodigoEstudianteSheet"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:inputType="number"
            android:maxLength="3"
            android:hint="Ej. 105"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Apellidos y Nombres"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/etNombreEstudianteSheet"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:inputType="textPersonName"
            android:hint="Ej. Perez Gomez, Juan"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvEstadoActualSheetEst"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Estado: A (Activo)"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSheetGuardarEst"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#2E7D32"
                android:text="Guardar"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnSheetInactivarEst"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:backgroundTint="#F57C00"
                android:text="Inactivar"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnSheetReactivarEst"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:backgroundTint="#2E7D32"
                android:text="Reactivar"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnSheetEliminarEst"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:backgroundTint="#C62828"
                android:text="Eliminar"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnSheetCancelarEst"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="#616161"
                android:text="Cancelar"
                android:textColor="#FFFFFF" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
