<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#0D3B66"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mantenimiento Estudiantes"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:elevation="2dp">

        <EditText
            android:id="@+id/etBuscarEstudiante"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@android:drawable/edit_text"
            android:hint="🔍 Buscar por código o nombre..."
            android:paddingHorizontal="12dp"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/rgFiltroEstadoEstudiante"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/rbActivosEst"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="Activos (A)"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbInactivosEst"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Inactivos (I)"
                android:textSize="13sp" />

            <RadioButton
                android:id="@+id/rbEliminadosEst"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Eliminados (*)"
                android:textSize="13sp" />
        </RadioGroup>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#D9E4F5"
        android:paddingVertical="8dp"
        android:paddingHorizontal="12dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="70dp"
            android:layout_height="wrap_content"
            android:text="Cód."
            android:textStyle="bold"
            android:textColor="#0D3B66" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Apellidos y Nombres"
            android:textStyle="bold"
            android:textColor="#0D3B66" />

        <TextView
            android:layout_width="45dp"
            android:layout_height="wrap_content"
            android:text="Estado"
            android:gravity="center"
            android:textStyle="bold"
            android:textColor="#0D3B66" />
    </LinearLayout>

    <ListView
        android:id="@+id/lvEstudiantes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#E0E0E0"
        android:dividerHeight="1dp"
        android:background="#FFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:elevation="6dp">

        <Button
            android:id="@+id/btnSalirEstudiantes"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#555555"
            android:text="Salir"
            android:textColor="#FFFFFF"
            app:cornerRadius="8dp" />

        <Button
            android:id="@+id/btnAdicionarEstudiante"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:backgroundTint="#0D3B66"
            android:text="+ Adicionar"
            android:textColor="#FFFFFF"
            app:cornerRadius="8dp" />
    </LinearLayout>

</LinearLayout>
